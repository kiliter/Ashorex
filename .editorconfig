root = true

# 默认使用 UTF-8、LF 和文件末尾换行，减少跨平台差异。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,dart,yaml,yml,json,md}]
indent_style = space
indent_size = 2

[*.{xml,html}]
indent_style = space
indent_size = 2

# Makefile 命令必须使用 Tab 缩进。
[Makefile]
indent_style = tab

# Markdown 的显式换行可能需要保留行尾空格。
[*.md]
trim_trailing_whitespace = false
