# 上岸本地开发环境变量示例（脚本与 IDE 共用）
#
# 用法：
#   cp .env.local.example .env.local
#   ./run.sh server        # 只起后端
#   ./run.sh admin         # 后端 + 管理后台 Vite 开发服务器（带热更新）
#   ./run.sh seed          # 写入种子数据（需后端已启动）
#
# ./run.sh 会自动加载同目录下的 .env.local，该文件已被 .gitignore 忽略。
# 命令行上显式导出的变量优先级更高，不会被本文件覆盖，例如：
#   SERVER_PORT=18099 ./run.sh server
#
# 注意：本文件的默认值只适合本机开发，绝不能用于生产部署。
# 生产部署请使用 infra/deploy.env.example 与 ./infra/scripts/deploy.sh。

# ── 服务监听 ────────────────────────────────────────────────
# 监听地址。0.0.0.0 表示同时接受本机与局域网访问，方便手机真机连本机后端调试。
# 只想本机访问时改为 127.0.0.1。
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=18080

# ── 首次启动管理员 ──────────────────────────────────────────
# 仅在数据库还没有任何管理员时生效；改密码后此处的值不再起作用。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=123456

# ── 安全 ────────────────────────────────────────────────────
# 本机 HTTP 调试必须为 false，否则浏览器不会回传管理后台 Session Cookie。
SESSION_COOKIE_SECURE=false
# 首次脚本启动会生成随机密钥并写回 .env.local；IDE 启动前须先完成此初始化。
JWT_SECRET=

# ── 日志 ────────────────────────────────────────────────────
# 默认显示 INFO 级别的常规启动与运行日志。
# 排查详细问题时可临时改为 DEBUG。
LOGGING_LEVEL_ROOT=INFO
# com.shangan 包的级别，单独控制业务日志（含每请求访问日志）。
LOGGING_LEVEL_COM_SHANGAN=INFO

# ── 管理后台前端（./run.sh admin）────────────────────────────
# Vite 开发服务器把 /admin/api 与 /actuator 代理到这里。
# 留空/注释掉时自动跟随 SERVER_PORT，改端口不用改两处；
# 只有后端跑在别的机器上才需要显式设置。
# ADMIN_DEV_PROXY=http://192.168.1.10:18080
# 构建产物是否生成 sourcemap。默认关闭：.js.map 内嵌完整 TS 源码，
# 而 /admin/assets/** 是匿名可读的，开启等于对外公开源码与内部接口结构。
# 本机排查前端问题时临时设为 1。
ADMIN_SOURCEMAP=0

# ── 后台截图工具（apps/admin-web/shot.mjs，仅本机视觉验证用）──
# 脚本刻意不写死密码，缺少 ADMIN_PASSWORD 会直接退出。
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# ── 本地数据目录 ────────────────────────────────────────────
# SQLite、附件与备份都放在这里；必须是本地磁盘，不能是 NAS 或 NFS。
# 相对路径以仓库根目录为基准，./run.sh 会自动创建缺失目录。
DATA_DIR=./data
BACKUP_DIR=./backup

# ── 种子数据（./run.sh seed）─────────────────────────────────
# 演示账号与学员账号的密码，仅在首次创建这些账号时生效。
SEED_DEMO_PASSWORD=demo1234
SEED_LEARNER_PASSWORD=pass1234
# 本机没有真实 Emby 时，先 `python3 scripts/fake_emby.py &` 起假服务，
# 再把下面这行的注释去掉执行 ./run.sh seed，即可填充 3 门课程 / 19 课时。
# 留空或注释掉表示跳过课程库填充。
# FAKE_EMBY=http://127.0.0.1:18099

# ── 假 Emby 服务（scripts/fake_emby.py，仅本机开发用）────────
# 与上面的 FAKE_EMBY 地址保持一致；改端口时两处都要改。
FAKE_EMBY_HOST=127.0.0.1
FAKE_EMBY_PORT=18099
FAKE_EMBY_API_KEY=fake-emby-api-key-local-dev-only
FAKE_EMBY_USER_ID=fakeuser00000000000000000000abcd

# ── Emby（可选，真实服务）───────────────────────────────────
# 不填时课程库为空，其余功能不受影响。也可以启动后在 /admin 的「运行配置」里填。
EMBY_BASE_URL=
EMBY_API_KEY=
EMBY_USER_ID=
EMBY_TIMEOUT_SECONDS=10

# ── Server 酱催办（可选）────────────────────────────────────
# 不填时离线催办不投递，客户端全屏催办仍然工作。
SERVERCHAN_SEND_KEY=
SERVERCHAN_NAG_ENABLED=true

# ── 功能开关 ────────────────────────────────────────────────
# 材料（PDF）按 ADR-0030 只预留模型，V2 保持关闭。
FEATURE_DOCUMENT_RESOURCES=false

# Spring Boot 原生配置：脚本与 IDE 共用，静态资源路径以仓库根为基准。
SPRING_WEB_RESOURCES_STATIC_LOCATIONS=file:./apps/server/src/main/resources/static/,classpath:/static/
SPRING_WEB_RESOURCES_CACHE_PERIOD=0
SPRING_WEB_RESOURCES_CHAIN_CACHE=false
SPRING_MAIN_BANNER_MODE=console
LOGGING_LEVEL_ORG_FLYWAYDB=INFO
LOGGING_LEVEL_COM_ZAXXER_HIKARI=INFO
# 可选：健康检查与代理留空时由脚本跟随 SERVER_PORT。
HEALTH_URL=
ADMIN_DEV_PROXY=
ATTACHMENTS_DIR=./data/attachments

# 个人 Bark 可信源站；自建服务按完整 HTTPS 源站（含端口）加入，逗号分隔。
BARK_ALLOWED_ORIGINS=https://api.day.app
