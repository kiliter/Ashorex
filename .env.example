# 应用地址；APP_DOMAIN 供 Caddy HTTPS 站点使用。
APP_BASE_URL=http://localhost:8080
APP_DOMAIN=

# 认证与播放票据密钥：本文件不得填写真实值。
JWT_SECRET=
PLAYBACK_TICKET_SECRET=

# 首次启动管理员：生产环境必须通过安全方式注入密码。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Emby 服务端集成配置
EMBY_BASE_URL=http://localhost:8096
EMBY_API_KEY=
EMBY_USER_ID=

# OpenAI-compatible LLM 配置
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_CONTEXT_TOKENS=
LLM_TEMPERATURE=

# OpenAI-compatible ASR 配置
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# 联网搜索 MCP 配置
WEB_SEARCH_MCP_URL=
WEB_SEARCH_MCP_BEARER_TOKEN=
WEB_SEARCH_MCP_ALLOWED_TOOLS=

# 业务规则与本地数据目录
QUIZ_DEBT_ESTIMATE_SECONDS=600
DATA_DIR=./data
BACKUP_DIR=./backup
