# 应用地址；APP_DOMAIN 供 Caddy HTTPS 站点使用。
APP_BASE_URL=http://localhost:18080
APP_DOMAIN=
SERVER_PORT=18080

# 认证与播放票据密钥：本文件不得填写真实值。
JWT_SECRET=
# 生产 HTTPS 部署必须为 true；本机或局域网 HTTP 调试可设为 false。
SESSION_COOKIE_SECURE=true
PLAYBACK_TICKET_SECRET=

# 首次启动管理员：生产环境必须通过安全方式注入密码。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Emby 服务端集成配置
EMBY_BASE_URL=http://localhost:8096
EMBY_API_KEY=
EMBY_USER_ID=

# OpenAI-compatible ASR（例如 mlx-audio）
ASR_BASE_URL=http://localhost:8000
ASR_API_KEY=
ASR_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit
ASR_LANGUAGE=Chinese
ASR_CHUNK_DURATION_SECONDS=30
ASR_TIMEOUT_SECONDS=1800

# CPA 或其他 OpenAI-compatible LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_LENGTH=131072
LLM_MAX_COMPLETION_TOKENS=8192
LLM_TIMEOUT_SECONDS=300

# OpenRouter 只用于同步模型目录元数据
OPENROUTER_API_KEY=

# 定时补全默认关闭，只补缺失全文和摘要
CONTENT_AUTO_FILL_ENABLED=false
CONTENT_AUTO_FILL_INTERVAL_MINUTES=15

# 业务规则与本地数据目录
QUIZ_DEBT_ESTIMATE_SECONDS=600
DATA_DIR=./data
BACKUP_DIR=./backup
