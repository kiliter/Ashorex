# 应用地址；APP_DOMAIN 供 Caddy HTTPS 站点使用。
APP_BASE_URL=http://localhost:18080
APP_DOMAIN=
SERVER_PORT=18080
# 容器部署必须为 0.0.0.0；应用默认只监听 127.0.0.1。
SERVER_ADDRESS=0.0.0.0

JWT_SECRET=
# 生产 HTTPS 部署必须为 true；本机或局域网 HTTP 调试可设为 false。
SESSION_COOKIE_SECURE=true

# 首次启动管理员：生产环境必须通过安全方式注入密码。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Emby 服务端集成配置
EMBY_BASE_URL=http://localhost:8096
EMBY_API_KEY=
EMBY_USER_ID=

# Server 酱催办推送；留空则离线催办不投递。
SERVERCHAN_SEND_KEY=
SERVERCHAN_NAG_ENABLED=true

# 本地数据目录；必须位于本地磁盘，不能是 NAS 或 NFS。
DATA_DIR=./data
BACKUP_DIR=./backup
