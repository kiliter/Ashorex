# 应用地址；APP_DOMAIN 供 Caddy HTTPS 站点使用。
APP_BASE_URL=http://localhost:8080
APP_DOMAIN=

# 认证与播放票据密钥：本文件不得填写真实值。
JWT_SECRET=
PLAYBACK_TICKET_SECRET=

# 首次启动管理员：生产环境必须通过安全方式注入密码。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Emby 服务端集成配置
EMBY_BASE_URL=http://localhost:8096
EMBY_API_KEY=
EMBY_USER_ID=

# 业务规则与本地数据目录
QUIZ_DEBT_ESTIMATE_SECONDS=600
DATA_DIR=./data
BACKUP_DIR=./backup
