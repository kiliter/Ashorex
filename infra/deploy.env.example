JWT_SECRET=
ADMIN_BOOTSTRAP_PASSWORD=

# 既有反向代理应使用 HTTPS，并将请求转发到 http://部署服务器IP:18080。

# 可选：升级器独立使用 host 网络。只影响 GitHub 版本源，daemon 拉镜像代理另配。
# UPDATER_HTTPS_PROXY=http://127.0.0.1:7890
# UPDATER_HTTP_PROXY=http://127.0.0.1:7890
# DOCKER_GID=实际宿主机 Docker socket 组号（deploy.sh 自动读取）
# SHANGAN_UPDATER_IMAGE=ghcr.io/kiliter/ashorex-server:固定正式版本
